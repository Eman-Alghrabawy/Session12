<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Day_01_G03</RootNamespace>
  </PropertyGroup>

  <!-- Copy the data files next to the .exe so XDocument.Load("Customers.xml")
       and File.ReadAllLines("dictionary_english.txt") work at runtime -->
  <ItemGroup>
    <None Update="Customers.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="dictionary_english.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
